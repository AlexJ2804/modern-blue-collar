# ─── Demo mode ────────────────────────────────────────────────────────────────
# true → local email/password auth (seeded admin), Twilio + QuickBooks no-op,
#        storage → MinIO, email → Mailpit. Leave false/unset for production.
# NOTE: for the Docker demo the authoritative template is the repo-root
# .env.example (consumed by docker-compose.yml). This file is for running the
# backend directly (npm run dev).
DEMO_MODE=false

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL (production — Digital Ocean, Railway, Render, etc.)
DATABASE_URL="postgresql://user:password@host:25060/dbname?sslmode=require"
# SQLite (local dev only — uncomment below, comment out PostgreSQL above)
# DATABASE_URL="file:./dev.db"

# ─── Google OAuth (console.cloud.google.com) ──────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://yourdomain.com/api/auth/google/callback

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_random_secret_string_min_32_chars

# ─── Email / SMTP (team-invite emails) ────────────────────────────────────────
# Standard SMTP. For local testing point at Mailpit: host=localhost port=1025.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@yourdomain.com

# ─── QuickBooks Online (developer.intuit.com) ─────────────────────────────────
QB_CLIENT_ID=your_qb_client_id
QB_CLIENT_SECRET=your_qb_client_secret
QB_REDIRECT_URI=https://yourdomain.com/api/quickbooks/callback
QB_ENVIRONMENT=sandbox

# ─── Twilio SMS (twilio.com/console) ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15550000000

# ─── Google Maps (console.cloud.google.com) ───────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ─── Wasabi Cloud Backup (wasabi.com) ─────────────────────────────────────────
# S3-compatible cloud storage for off-site database backups.
# Nightly backup at 03:00 uploads to Wasabi automatically when configured.
# Leave blank to use local-only backups.
WASABI_BUCKET=your-company-backups
WASABI_ACCESS_KEY=your_wasabi_access_key
WASABI_SECRET_KEY=your_wasabi_secret_key
WASABI_REGION=us-east-1
WASABI_ENDPOINT=https://s3.us-east-1.wasabisys.com

# ─── Object storage for job photos (S3-compatible) ────────────────────────────
# Falls back to the WASABI_* vars above when unset. For local testing point at
# MinIO: S3_ENDPOINT=http://localhost:9000, keys=minioadmin.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=mbc-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3001
APP_URL=https://yourdomain.com
NODE_ENV=production

# ─── Branding / White-label tokens (see brand.config.js) ──────────────────────
BRAND_COMPANY_NAME=My Company LLC
BRAND_COMPANY_SLOGAN=Field Service Management
BRAND_COMPANY_PHONE=+15550001234
BRAND_COMPANY_EMAIL=office@mycompany.com
BRAND_COMPANY_ADDRESS=123 Main St, Anytown, KS 67000

# Trade type: electrical | plumbing | hvac | contracting
BRAND_TRADE_TYPE=electrical

# Technician label override (auto-derived from BRAND_TRADE_TYPE if blank)
BRAND_TECH_LABEL=

# Industry label for pricebook (auto-derived if blank)
BRAND_INDUSTRY_LABEL=

# Theme colours (hex) — quote values so # is not treated as a comment
BRAND_COLOR_PRIMARY="#f5a623"
BRAND_COLOR_SECONDARY="#1a1a2e"
BRAND_COLOR_ACCENT="#ffffff"
BRAND_COLOR_NAV_BG="#1a1a2e"
BRAND_COLOR_NAV_TEXT="#ffffff"
BRAND_COLOR_HEADER_BG="#f5a623"
BRAND_COLOR_HEADER_TEXT="#1a1a2e"

# Default US state for customer address forms
BRAND_DEFAULT_STATE=KS

# Timezone for cron jobs
BRAND_TIMEZONE=America/Chicago
