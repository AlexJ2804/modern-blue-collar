# =============================================================================
# Modern Blue Collar — environment configuration (used by docker-compose.yml)
#
#   LOCAL DEMO:  cp .env.example .env && docker compose --profile demo up --build
#                The values below already point at the bundled MinIO + Mailpit +
#                Postgres, so the demo works with NO changes.
#
#   PRODUCTION:  set DEMO_MODE=false, point DATABASE_URL / S3 / SMTP at your real
#                services (e.g. DigitalOcean Postgres, Wasabi, real SMTP), fill in
#                the Google / QuickBooks / Twilio creds you use, then:
#                  docker compose up -d --build        (note: NO --profile demo)
# =============================================================================

# ─── Demo switch ─────────────────────────────────────────────────────────────
# true  → local email/password auth (seeded admin), Twilio + QuickBooks no-op,
#         storage → MinIO, email → Mailpit.
# false → full production behavior (real integrations per the vars below).
DEMO_MODE=true

# ─── Postgres (the `postgres` compose service) ───────────────────────────────
POSTGRES_USER=mbc
POSTGRES_PASSWORD=mbc_demo_password
POSTGRES_DB=mbc
POSTGRES_PORT=5432
# App DB connection. Host = the compose service name `postgres`.
# PRODUCTION: replace with your managed DB URL (often needs ?sslmode=require).
DATABASE_URL=postgresql://mbc:mbc_demo_password@postgres:5432/mbc?schema=public

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3001
APP_URL=http://localhost:3001
# Demo uses 'development' so API error messages are readable. Use 'production' live.
NODE_ENV=development
JWT_SECRET=demo_dev_secret_change_me_to_a_random_32_plus_char_string
JWT_EXPIRES=8h

# Seeded demo admin (created on boot when DEMO_MODE=true). CHANGE FOR PRODUCTION.
ADMIN_EMAIL=admin@demo.test
ADMIN_PASSWORD=demo1234
ADMIN_FIRST=Demo
ADMIN_LAST=Admin
# Password assigned to seeded demo team members (seed_jobs.js)
DEFAULT_PASSWORD=demo1234

# ─── Object storage for job photos (AWS S3 SDK) ──────────────────────────────
# DEMO: the bundled MinIO service. PRODUCTION: Wasabi / AWS S3 / DO Spaces
# (change endpoint + keys only — no code changes).
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=mbc-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# MinIO root credentials (demo service). Keep in sync with S3_ACCESS/SECRET above.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── Email / SMTP ────────────────────────────────────────────────────────────
# DEMO: the bundled Mailpit catch-all (web UI at http://localhost:8025).
# PRODUCTION: your real SMTP host/port/user/pass.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@demo.test
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ─── Branding / white-label (see brand.config.js) ────────────────────────────
BRAND_COMPANY_NAME=Modern Blue Collar
BRAND_COMPANY_SLOGAN=Field Service Management
# electrical | plumbing | hvac | plumbing-hvac | contracting
BRAND_TRADE_TYPE=plumbing-hvac
BRAND_TIMEZONE=America/Chicago

# =============================================================================
# PRODUCTION integrations — left blank/dormant in demo. Fill in + DEMO_MODE=false
# to go live. See SETUP.md / DEPLOYMENT.md for how to obtain each credential.
# =============================================================================

# Off-site DB backups (Wasabi / S3-compatible). In demo these point at MinIO so
# the backup job also works locally; in production use your real Wasabi bucket.
WASABI_ENDPOINT=http://minio:9000
WASABI_REGION=us-east-1
WASABI_BUCKET=mbc-backups
WASABI_ACCESS_KEY=minioadmin
WASABI_SECRET_KEY=minioadmin

# Google OAuth (optional team SSO). Blank → "Continue with Google" hidden in demo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# QuickBooks Online. Blank / DEMO_MODE → "Connect" shown but live auth disabled.
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REDIRECT_URI=
QB_ENVIRONMENT=sandbox

# Twilio SMS. Blank / DEMO_MODE → outbound SMS is logged to console, not sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Google Maps (optional)
GOOGLE_MAPS_API_KEY=
